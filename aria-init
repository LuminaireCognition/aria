    RUNTIME_RECOVERED_CORRUPT=0
    RUNTIME_REGISTRY_RECOVERED=0
    RUNTIME_RECOVERY_MESSAGES=()
    RUNTIME_REGISTRY_BACKUP_PATH=""
    RUNTIME_CONFIG_BACKUP_PATH=""
    JSON_UPDATED_REGISTRY=""
    JSON_UPDATED_CONFIG=""

    if [[ "$PILOT_CHAR_ID" == "0" ]]; then
        return 0
    fi

    local now registry_json updated_registry config_json updated_config
    now="$(get_utc_iso)"

    json_load_or_default "$REGISTRY_FILE" '{"schema_version":"1.0","pilots":[]}'
    registry_json="$JSON_LOAD_CONTENT"
    if [[ "$JSON_LOAD_RECOVERED" -eq 1 ]]; then
        RUNTIME_RECOVERED_CORRUPT=1
        RUNTIME_REGISTRY_RECOVERED=1
        RUNTIME_REGISTRY_BACKUP_PATH="$JSON_LOAD_BACKUP_PATH"
        RUNTIME_RECOVERY_MESSAGES+=("Recovered userdata/pilots/_registry.json -> ${JSON_LOAD_BACKUP_PATH}")
    fi
    updated_registry="$(json_merge_registry "$registry_json" "$PILOT_CHAR_ID" "$CHAR_NAME" "$PILOT_DIRNAME" "$now")"
    JSON_UPDATED_REGISTRY="$updated_registry"

    json_load_or_default "$CONFIG_FILE" '{}'
    config_json="$JSON_LOAD_CONTENT"
    if [[ "$JSON_LOAD_RECOVERED" -eq 1 ]]; then
        RUNTIME_RECOVERED_CORRUPT=1
        RUNTIME_CONFIG_BACKUP_PATH="$JSON_LOAD_BACKUP_PATH"
        RUNTIME_RECOVERY_MESSAGES+=("Recovered userdata/config.json -> ${JSON_LOAD_BACKUP_PATH}")
    fi
    updated_config="$(json_merge_config "$config_json" "$PILOT_CHAR_ID")"
    JSON_UPDATED_CONFIG="$updated_config"
}

apply_runtime_state_update() {
    if [[ "$PILOT_CHAR_ID" == "0" ]]; then
        return 0
    fi

    atomic_write_json "$REGISTRY_FILE" "$JSON_UPDATED_REGISTRY"
    atomic_write_json "$CONFIG_FILE" "$JSON_UPDATED_CONFIG"
}

warn_registry_orphans_after_recovery() {
    if [[ "$RUNTIME_REGISTRY_RECOVERED" -ne 1 ]]; then
        return 0
    fi

    local -a disk_dirs=()
    local -a orphan_dirs=()
    local -A registry_dirs=()
    local d base

    while IFS= read -r d; do
        base="$(basename "$d")"
        disk_dirs+=("$base")
    done < <(find "$PILOTS_ROOT" -maxdepth 1 -mindepth 1 -type d -print 2>/dev/null | grep -E '/[1-9][0-9]*_' | sort || true)

    while IFS= read -r d; do
        if [[ -n "$d" ]]; then
            registry_dirs["$d"]=1
        fi
    done < <(json_registry_directories_from_content "$JSON_UPDATED_REGISTRY" 2>/dev/null || true)

    for d in "${disk_dirs[@]}"; do
        if [[ -z "${registry_dirs[$d]+x}" ]]; then
            orphan_dirs+=("$d")
        fi
    done

    if [[ ${#orphan_dirs[@]} -gt 0 ]]; then
        print_warning "Registry recovered to defaults; found pilot directories not referenced in userdata/pilots/_registry.json:"
        printf "  %s\n" "${orphan_dirs[@]}"
        print_info "Review these directories and re-add needed pilots to the registry."
    fi
}

confirm_recovery_or_abort() {
    if [[ "$RUNTIME_RECOVERED_CORRUPT" -ne 1 ]]; then
        return 0
    fi

    warn_registry_orphans_after_recovery

    print_warning "Corrupt JSON files were detected during runtime-state update."
    local msg
    for msg in "${RUNTIME_RECOVERY_MESSAGES[@]}"; do
        echo "  - ${msg}"
    done
    if [[ -n "$RUNTIME_CONFIG_BACKUP_PATH" ]] && [[ "$RUNTIME_REGISTRY_RECOVERED" -ne 1 ]] && [[ -f "$REGISTRY_FILE" ]] && json_is_valid "$REGISTRY_FILE"; then
        print_registered_pilots
    fi

    if [[ "$FORCE" -eq 1 ]]; then
        print_info "--force set; skipping recovery confirmation."
        return 0
    fi

    if ! prompt_yes_no "Continue after corruption recovery? (default abort)" "n"; then
        print_warning "Aborted after corruption recovery. Review backups and rerun when ready."
        exit 1
    fi
}

run_seed_command() {
    local label="$1"
    local cmd="$2"
    local description="$3"

    echo -en "  > ${label}..."
    set +e
    local stderr_output
    stderr_output=$(eval "$cmd" 2>&1 1>/dev/null)
    local rc=$?
    set -e
    if [[ $rc -eq 0 ]]; then
        echo -e " [${GREEN}OK${NC}]"
        return 0
    else
        echo -e " [${RED}FAIL${NC}]"
        local hint
        hint=$(echo "$stderr_output" | grep -v '^$' | tail -n 1)
        if [[ -n "$hint" ]]; then
            print_warning "  Hint: ${hint}"
        fi
        print_warning "  Retry manually: ${cmd}"
        return 1
    fi
}

seed_game_data() {
    if [[ "$SKIP_SEED" -eq 1 ]]; then
        return 0
    fi

    print_header "GAME DATA SETUP"
    echo ""
    echo "Downloading game data caches (~100MB from public EVE data sources)..."
    echo ""

    local failures=0
    local total=5

    run_seed_command "SDE database (item/skill data)" \
        "uv run aria-esi sde-seed" \
        "Item/skill/blueprint database" || failures=$((failures + 1))

    run_seed_command "Fitting engine (ship stats)" \
        "uv run aria-esi eos-seed" \
        "Fitting engine data" || failures=$((failures + 1))

    run_seed_command "Market prices" \
        "uv run aria-esi market-seed" \
        "Market price cache" || failures=$((failures + 1))

    run_seed_command "Sovereignty map" \
        "uv run aria-esi sov-update" \
        "Sovereignty data" || failures=$((failures + 1))

    run_seed_command "Persona context" \
        "uv run aria-esi persona-context" \
        "Persona compilation" || failures=$((failures + 1))

    echo ""
    local succeeded=$((total - failures))
    if [[ "$failures" -eq 0 ]]; then
        print_success "All ${total} data sources seeded successfully"
    else
        print_warning "${succeeded}/${total} seeded (${failures} failed)"
        print_info "Re-run failed seeds with: ./aria-init --seed-only"
    fi

    echo ""
    print_footer
}

