check_prerequisites() {
    local errors=0

    if ! command -v uv &>/dev/null; then
        print_error "uv is required but was not found on PATH."
        echo "Install from: https://docs.astral.sh/uv/"
        errors=$((errors + 1))
    fi
    if ! command -v jq &>/dev/null; then
        print_warning "jq not found on PATH; using uv run python stdlib fallback for JSON operations."
        print_info "Install jq for faster JSON processing: https://jqlang.org/download/"
    fi

    # Check templates directory
    if [[ ! -d "$TEMPLATES_DIR" ]]; then
        print_error "Templates directory not found: $TEMPLATES_DIR"
        errors=$((errors + 1))
    fi

    # Check required template files
    local required_templates=(
        "profile.template.md"
        "operations.template.md"
        "ships.template.md"
        "missions.template.md"
        "exploration.template.md"
        "goals.template.md"
        "industry/blueprints.template.md"
    )

    for template in "${required_templates[@]}"; do
        if [[ ! -f "$TEMPLATES_DIR/$template" ]]; then
            print_error "Missing template: $template"
            errors=$((errors + 1))
        fi
    done

    return $errors
}

slugify_name() {
    local input="$1"
    local slug
    slug=$(printf "%s" "$input" | LC_ALL=C tr '[:upper:]' '[:lower:]')
    slug=${slug// /_}
    slug=$(printf "%s" "$slug" | LC_ALL=C sed 's/[^a-z0-9_]//g')
    slug=$(printf "%s" "$slug" | cut -c1-32)
    if [[ -z "$slug" ]]; then
        slug="pilot"
    fi
    printf "%s" "$slug"
}

detect_runtime() {
    local uname_s
    uname_s="$(uname -s 2>/dev/null || echo unknown)"

    if [[ "$uname_s" == *MINGW* ]] || [[ "$uname_s" == *MSYS* ]] || [[ "$uname_s" == *CYGWIN* ]]; then
        RUNTIME_CLASSIFICATION="unsupported"
        return
    fi
    if [[ -f "/.dockerenv" ]] || [[ -f "/run/.containerenv" ]]; then
        RUNTIME_CLASSIFICATION="container"
        return
    fi
    if [[ -n "${WSL_INTEROP:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null; then
        RUNTIME_CLASSIFICATION="wsl2"
        return
    fi
    if [[ "$uname_s" == "Darwin" ]]; then
        RUNTIME_CLASSIFICATION="macos"
        return
    fi
    RUNTIME_CLASSIFICATION="linux"
}

show_runtime_advisory() {
    detect_runtime
    case "$RUNTIME_CLASSIFICATION" in
        unsupported)
            print_error "Native Windows shell is unsupported. Use WSL2 on Windows 11."
            exit 1
            ;;
        container) print_info "Runtime: container (isolated)" ;;
        wsl2) print_info "Runtime: WSL2" ;;
        macos) print_info "Runtime: macOS" ;;
        *) print_info "Runtime: Linux" ;;
    esac
}

get_utc_iso() {
