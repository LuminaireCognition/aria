    mkdir -p "$PILOTS_ROOT"

    if [[ -n "${ARIA_PILOT:-}" ]]; then
        selected_id="${ARIA_PILOT}"
    elif [[ -f "$CONFIG_FILE" ]]; then
        active_id=$(uv run python - "$CONFIG_FILE" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as f:
        c = json.load(f)
    print(str(c.get("active_pilot","")))
except Exception:
    print("")
PY
)
        selected_id="${active_id}"
    fi

    set +e
    from_registry=$(resolve_existing_pilot_from_registry "$selected_id")
    registry_status=$?
    set -e
    if [[ "$registry_status" -eq 0 ]]; then
        PILOT_CHAR_ID="${from_registry%%|*}"
        PILOT_DIRNAME="${from_registry#*|}"
        if [[ -z "$PILOT_DIRNAME" ]]; then
            print_error "Registry entry for character ID ${PILOT_CHAR_ID} is missing a directory value."
            exit 1
        fi
        PILOT_SLUG="${PILOT_DIRNAME#*_}"
    else
        case "$registry_status" in
            3)
                print_error "Multiple pilots found in userdata/pilots/_registry.json with no selector."
                print_registered_pilots
                echo "Set ARIA_PILOT=<character_id> or set active_pilot in userdata/config.json."
                exit 1
                ;;
            4)
                print_warning "Selected pilot ID '${selected_id}' was not found in userdata/pilots/_registry.json."
                print_info "Using selected pilot ID '${selected_id}' directly."
                ;;
            5)
                if [[ -n "$selected_id" ]]; then
                    print_warning "Invalid JSON in userdata/pilots/_registry.json."
                    print_info "Using selected pilot ID '${selected_id}' directly."
                else
                    print_warning "Invalid JSON in userdata/pilots/_registry.json. Continuing with credentials/placeholder resolution."
                fi
                ;;
            2)
                if [[ -n "$selected_id" ]]; then
                    print_warning "Selected pilot ID '${selected_id}' cannot be resolved because userdata/pilots/_registry.json is missing."
                    print_info "Using selected pilot ID '${selected_id}' directly."
                fi
                ;;
            *)
                ;;
        esac

        if [[ -n "$selected_id" ]] && [[ "$registry_status" -eq 2 || "$registry_status" -eq 4 || "$registry_status" -eq 5 ]]; then
            PILOT_CHAR_ID="$selected_id"
        else
            PILOT_CHAR_ID="$(resolve_character_id_from_credentials)"
            if [[ -z "$PILOT_CHAR_ID" ]]; then
                PILOT_CHAR_ID="0"
            fi
        fi
        PILOT_SLUG="$(slugify_name "$CHAR_NAME")"
        PILOT_DIRNAME="${PILOT_CHAR_ID}_${PILOT_SLUG}"
    fi

    if [[ "$PILOT_CHAR_ID" == "0" ]]; then
        local -a placeholders=()
        local d
        while IFS= read -r d; do
            placeholders+=("$d")
        done < <(find "$PILOTS_ROOT" -maxdepth 1 -mindepth 1 -type d -name '0_*' 2>/dev/null | sort || true)
        if [[ ${#placeholders[@]} -gt 0 ]]; then
            local expected="$PILOTS_ROOT/$PILOT_DIRNAME"
            if [[ ${#placeholders[@]} -gt 1 ]]; then
                print_error "Multiple placeholder directories found in userdata/pilots/:"
                printf "  %s\n" "${placeholders[@]}"
                exit 1
            fi
            if [[ "${placeholders[0]}" != "$expected" ]]; then
                print_error "Found existing placeholder directory '${placeholders[0]}'."
                echo "Re-run with the same character name, delete the old directory, or run OAuth first."
                exit 1
            fi
        fi
    else
        local -a known_dirs=()
        local d
        while IFS= read -r d; do
            known_dirs+=("$d")
        done < <(find "$PILOTS_ROOT" -maxdepth 1 -mindepth 1 -type d -name "${PILOT_CHAR_ID}_*" 2>/dev/null | sort || true)
        if [[ ${#known_dirs[@]} -gt 1 ]]; then
            print_error "Multiple directories found for character ID ${PILOT_CHAR_ID}:"
            printf "  %s\n" "${known_dirs[@]}"
            exit 1
        fi
        if [[ ${#known_dirs[@]} -eq 1 ]] && [[ -z "$from_registry" ]]; then
            PILOT_DIRNAME="$(basename "${known_dirs[0]}")"
            PILOT_SLUG="${PILOT_DIRNAME#*_}"
        fi
    fi

    PILOT_DIR="$PILOTS_ROOT/$PILOT_DIRNAME"
    DATA_DIR="$PILOT_DIR"
    INDUSTRY_DIR="$PILOT_DIR/industry"
}

check_existing_installation() {
    local existing_files=()

    local check_files=(
        "$DATA_DIR/profile.md"
        "$DATA_DIR/operations.md"
        "$DATA_DIR/ships.md"
        "$DATA_DIR/missions.md"
        "$DATA_DIR/exploration.md"
        "$DATA_DIR/goals.md"
        "$INDUSTRY_DIR/blueprints.md"
    )

    for file in "${check_files[@]}"; do
        if [[ -f "$file" ]]; then
            existing_files+=("$(basename "$file")")
        fi
    done

    if [[ ${#existing_files[@]} -gt 0 ]]; then
        return 0  # Files exist
    else
        return 1  # Clean installation
    fi
}

