resolve_character_id_from_credentials() {
    local -a cred_ids=()
    local file base
    if [[ ! -d "$CREDENTIALS_DIR" ]]; then
        echo ""
        return
    fi
    while IFS= read -r file; do
        base="$(basename "$file")"
        cred_ids+=("${base%.json}")
    done < <(find "$CREDENTIALS_DIR" -maxdepth 1 -type f -name '*.json' -print | grep -E '/[0-9]+\.json$' | sort || true)

    if [[ ${#cred_ids[@]} -eq 1 ]]; then
        echo "${cred_ids[0]}"
        return
    fi
    if [[ ${#cred_ids[@]} -gt 1 ]]; then
        print_error "Multiple credential files found in userdata/credentials/:"
        for id in "${cred_ids[@]}"; do
            echo "  ${id}.json"
        done
        echo "Set ARIA_PILOT=<character_id> or set active_pilot in userdata/config.json."
        exit 1
    fi
    echo ""
}

resolve_existing_pilot_from_registry() {
    local selected_id="$1"
    if [[ ! -f "$REGISTRY_FILE" ]]; then
        return 2
    fi
    if ! json_is_valid "$REGISTRY_FILE"; then
        return 5
    fi

    local pilot_count match
    detect_json_engine
    if [[ "$JSON_ENGINE" == "jq" ]]; then
        pilot_count="$(jq -r '(.pilots // []) | length' "$REGISTRY_FILE")"
    else
        pilot_count="$(
            uv run python -c 'import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
pilots = data.get("pilots") if isinstance(data, dict) else []
print(len(pilots) if isinstance(pilots, list) else 0)' "$REGISTRY_FILE"
        )"
    fi

    if [[ -n "$selected_id" ]]; then
        if [[ "$JSON_ENGINE" == "jq" ]]; then
            match="$(
                jq -r --arg sid "$selected_id" \
                    'first((.pilots // [])[] | select((.character_id | tostring) == $sid) | "\(.character_id)|\(.directory // "")") // ""' \
                    "$REGISTRY_FILE"
            )"
        else
            match="$(
                uv run python -c 'import json, sys
selected_id = sys.argv[2]
with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
pilots = data.get("pilots") if isinstance(data, dict) else []
if not isinstance(pilots, list):
    pilots = []
for pilot in pilots:
    if isinstance(pilot, dict) and str(pilot.get("character_id", "")) == selected_id:
        print(f"{pilot.get(\"character_id\", \"\")}|{pilot.get(\"directory\", \"\")}")
        raise SystemExit(0)
print("")' "$REGISTRY_FILE" "$selected_id"
            )"
        fi
        if [[ -z "$match" ]]; then
            return 4
        fi
        echo "$match"
        return 0
    fi

    if [[ "$pilot_count" -gt 1 ]]; then
        return 3
    fi
    if [[ "$pilot_count" -eq 1 ]]; then
        if [[ "$JSON_ENGINE" == "jq" ]]; then
            jq -r 'first((.pilots // [])[] | "\(.character_id)|\(.directory // "")")' "$REGISTRY_FILE"
        else
            uv run python -c 'import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
pilots = data.get("pilots") if isinstance(data, dict) else []
if isinstance(pilots, list) and pilots:
    pilot = pilots[0]
    if isinstance(pilot, dict):
        print(f"{pilot.get(\"character_id\", \"\")}|{pilot.get(\"directory\", \"\")}")' "$REGISTRY_FILE"
        fi
        return 0
    fi
    return 1
}

