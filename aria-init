}

file_mtime_epoch() {
    local path="$1"
    if stat -c %Y "$path" >/dev/null 2>&1; then
        stat -c %Y "$path"
    else
        stat -f %m "$path"
    fi
}

detect_json_engine() {
    if [[ -n "$JSON_ENGINE" ]]; then
        return 0
    fi
    if command -v jq &>/dev/null; then
        JSON_ENGINE="jq"
    else
        JSON_ENGINE="python"
    fi
}

install_json_lock_trap() {
    if [[ "$JSON_LOCK_TRAP_INSTALLED" -eq 1 ]]; then
        return 0
    fi
    trap release_json_locks_on_exit EXIT INT TERM
    JSON_LOCK_TRAP_INSTALLED=1
}

register_json_lock() {
    local lockdir="$1"
    local held
    for held in "${JSON_LOCKS_HELD[@]}"; do
        if [[ "$held" == "$lockdir" ]]; then
            return 0
        fi
    done
    JSON_LOCKS_HELD+=("$lockdir")
}

unregister_json_lock() {
    local lockdir="$1"
    local -a remaining=()
    local held
    for held in "${JSON_LOCKS_HELD[@]}"; do
        if [[ "$held" != "$lockdir" ]]; then
            remaining+=("$held")
        fi
    done
    JSON_LOCKS_HELD=("${remaining[@]}")
}

release_json_lock() {
    local lockdir="$1"
    if [[ -d "$lockdir" ]]; then
        rmdir "$lockdir" 2>/dev/null || true
    fi
    unregister_json_lock "$lockdir"
}

release_json_locks_on_exit() {
    local held
    for held in "${JSON_LOCKS_HELD[@]}"; do
        if [[ -d "$held" ]]; then
            rmdir "$held" 2>/dev/null || true
        fi
    done
    JSON_LOCKS_HELD=()
}

acquire_json_lock() {
    local lockdir="$1"
    install_json_lock_trap
    if mkdir "$lockdir" 2>/dev/null; then
        register_json_lock "$lockdir"
        return 0
    fi
    if [[ ! -d "$lockdir" ]]; then
        mkdir -p "$lockdir"
        register_json_lock "$lockdir"
        return 0
    fi

    local now age mtime
    now=$(date +%s)
    mtime="$(file_mtime_epoch "$lockdir" 2>/dev/null || echo "$now")"
    age=$((now - mtime))
    if (( age > 300 )); then
        print_warning "Stale lock detected (${age}s old). Breaking lock at ${lockdir}."
        rmdir "$lockdir" 2>/dev/null || true
        mkdir "$lockdir"
        register_json_lock "$lockdir"
        return 0
    fi

    print_error "Lock exists at ${lockdir}. If no other ARIA process is running, remove it:"
    echo "  rmdir ${lockdir}"
    exit 1
}

atomic_write_json() {
    local path="$1"
    local content="$2"
    local dir lockdir tmp

    dir="$(dirname "$path")"
    mkdir -p "$dir"
    lockdir="${path}.lock"
    acquire_json_lock "$lockdir"

    tmp="$(mktemp "${dir}/.$(basename "$path").tmp.XXXXXX")"
    {
        printf "%s\n" "$content"
    } > "$tmp"

    mv "$tmp" "$path"
    release_json_lock "$lockdir"
}

JSON_LOAD_RECOVERED=0
JSON_LOAD_BACKUP_PATH=""
JSON_LOAD_CONTENT=""

json_load_or_default() {
    local path="$1"
    local default_json="$2"

    JSON_LOAD_RECOVERED=0
    JSON_LOAD_BACKUP_PATH=""
    JSON_LOAD_CONTENT=""

    if [[ ! -f "$path" ]]; then
        JSON_LOAD_CONTENT="$default_json"
        return 0
    fi

    if json_is_valid "$path"; then
        JSON_LOAD_CONTENT="$(cat "$path")"
        return 0
    fi

    local stamp backup
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    backup="${path}.corrupt.${stamp}"
    JSON_LOAD_RECOVERED=1
    JSON_LOAD_BACKUP_PATH="$backup"
    cp "$path" "$backup"
    print_warning "Detected corrupt JSON at ${path}. Backup written to ${backup}." >&2
    JSON_LOAD_CONTENT="$default_json"
}

json_is_valid() {
    local path="$1"
    detect_json_engine
    if [[ "$JSON_ENGINE" == "jq" ]]; then
        jq -e . "$path" >/dev/null 2>&1
        return $?
    fi
    uv run python -c "import json,sys;json.load(open(sys.argv[1], encoding='utf-8'))" "$path" >/dev/null 2>&1
}

json_merge_registry() {
    local input_json="$1"
    local char_id="$2"
    local char_name="$3"
    local directory="$4"
    local now="$5"
    detect_json_engine
    if [[ "$JSON_ENGINE" == "jq" ]]; then
        jq \
            --arg char_id "$char_id" \
            --arg char_name "$char_name" \
            --arg directory "$directory" \
            --arg now "$now" \
            '
            .schema_version = (.schema_version // "1.0")
            | .pilots = (.pilots // [])
            | .pilots |= (
                if any(.[]; (.character_id | tostring) == $char_id) then
                    map(
                        if (.character_id | tostring) == $char_id then
                            .character_id = $char_id
                            | .character_name = $char_name
                            | .directory = $directory
                            | .faction = (.faction // "Unknown")
                            | .account_tag = (.account_tag // "main")
                            | .created_at = (.created_at // $now)
                            | .last_active = $now
                        else
                            .
                        end
                    )
                else
                    . + [{
                        "character_id": $char_id,
                        "character_name": $char_name,
                        "directory": $directory,
                        "faction": "Unknown",
                        "account_tag": "main",
                        "created_at": $now,
                        "last_active": $now
                    }]
                end
            )
            ' <<< "$input_json"
        return 0
    fi

    uv run python -c 'import json, sys
char_id, char_name, directory, now = sys.argv[1:5]
data = json.loads(sys.stdin.read() or "{}")
if not isinstance(data, dict):
    data = {}
data["schema_version"] = str(data.get("schema_version") or "1.0")
pilots = data.get("pilots")
if not isinstance(pilots, list):
    pilots = []
updated = False
for pilot in pilots:
    if isinstance(pilot, dict) and str(pilot.get("character_id", "")) == char_id:
        pilot["character_id"] = char_id
        pilot["character_name"] = char_name
        pilot["directory"] = directory
        pilot["faction"] = pilot.get("faction") or "Unknown"
        pilot["account_tag"] = pilot.get("account_tag") or "main"
        pilot["created_at"] = pilot.get("created_at") or now
        pilot["last_active"] = now
        updated = True
if not updated:
    pilots.append({
        "character_id": char_id,
        "character_name": char_name,
        "directory": directory,
        "faction": "Unknown",
        "account_tag": "main",
        "created_at": now,
        "last_active": now,
    })
data["pilots"] = pilots
print(json.dumps(data, indent=2, sort_keys=False))' "$char_id" "$char_name" "$directory" "$now" <<< "$input_json"
}

