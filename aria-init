    fi
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --version|-v)
                show_version
                exit 0
                ;;
            --test)
                check_prerequisites || exit 1
                show_runtime_advisory
                run_test_mode
                exit 0
                ;;
            --force)
                FORCE=1
                ;;
            --skip-seed|--no-seed)
                SKIP_SEED=1
                ;;
            --seed-only)
                check_prerequisites || exit 1
                seed_game_data
                exit $?
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
        shift
    done

    # Show intro
    show_intro

    # Check prerequisites
    echo "Checking prerequisites..."
    if ! check_prerequisites; then
        print_error "Prerequisites check failed"
        exit 1
    fi
    print_success "All prerequisites met"
    show_runtime_advisory
    echo ""

    # Collect information
    collect_character_info
    resolve_pilot_context
    if check_existing_installation; then
        handle_existing_installation
    fi
    show_settings_summary

    # Generate files
    generate_files
    prepare_runtime_state_update
    confirm_recovery_or_abort
    apply_runtime_state_update

    if [[ -d "$SCRIPT_DIR/data" ]]; then
        echo ""
        print_info "Note: Found legacy data/ directory. This is no longer used by ARIA."
        echo "If you have no custom data there, you can delete it: rm -rf data/"
    fi

    # Seed game data caches
    seed_game_data

    # Show completion with ESI info
    show_esi_info
    show_completion
}

# Run main function
main "$@"
